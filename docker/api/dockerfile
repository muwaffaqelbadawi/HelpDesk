# Restore and build the API and both test projects from the repository root.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY global.json ./
COPY backend/src/HelpDesk.slnx ./backend/src/
COPY backend/src/HelpDesk.Api/HelpDesk.Api.csproj ./backend/src/HelpDesk.Api/
COPY backend/src/HelpDesk.Tests.Unit/HelpDesk.Tests.Unit.csproj ./backend/src/HelpDesk.Tests.Unit/
COPY backend/src/HelpDesk.Tests.Integration/HelpDesk.Tests.Integration.csproj ./backend/src/HelpDesk.Tests.Integration/

RUN dotnet restore backend/src/HelpDesk.slnx

COPY backend/src/ ./backend/src/

RUN dotnet build backend/src/HelpDesk.slnx \
    --configuration Release \
    --no-restore

# Unit tests run during the deployment image build and gate publishing.
FROM build AS unit-tests

RUN dotnet test backend/src/HelpDesk.Tests.Unit/HelpDesk.Tests.Unit.csproj \
    --configuration Release \
    --no-build \
    --no-restore

# Run unit tests on demand in a container.
FROM build AS tests

ENTRYPOINT ["dotnet", "test", "backend/src/HelpDesk.Tests.Unit/HelpDesk.Tests.Unit.csproj", "--configuration", "Release", "--no-build", "--no-restore"]

# Run integration tests against a reachable SQL Server.
FROM build AS integration-tests

ENTRYPOINT ["dotnet", "test", "backend/src/HelpDesk.Tests.Integration/HelpDesk.Tests.Integration.csproj", "--configuration", "Release", "--no-build", "--no-restore"]

# Publish only after the unit-test gate succeeds.
FROM unit-tests AS publish

RUN dotnet publish backend/src/HelpDesk.Api/HelpDesk.Api.csproj \
    --configuration Release \
    --output /app/publish \
    --no-build \
    --no-restore

# Keep the runtime image free of the SDK and test artifacts.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

ENV ASPNETCORE_HTTP_PORTS=8080

EXPOSE 8080

COPY --from=publish /app/publish/ ./

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/Logs \
    && chown "$APP_UID:$APP_UID" /app/Logs

USER $APP_UID

ENTRYPOINT ["dotnet", "HelpDesk.Api.dll"]
