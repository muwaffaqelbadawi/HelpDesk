# Copy this file to .env in the repository root. Docker Compose reads that file
# automatically. ASP.NET Core does not load .env files; host-launched processes
# need the application variables exported in their own environment.
# Replace the REPLACE_* values with your own local secrets. Never commit .env.

# Application settings for a locally launched API or test process.
# Optional: launch profiles already select Development for `dotnet run`.
ASPNETCORE_ENVIRONMENT=Development

# Required by a host-launched API. This example uses the local SQL Server
# published on localhost:1433 and its normal HelpDeskDB database.
ConnectionStrings__AppDBConnection=Server=localhost,1433;Database=HelpDeskDB;User Id=sa;Password=REPLACE_WITH_A_UNIQUE_STRONG_SQL_PASSWORD;TrustServerCertificate=True

# Required by the integration-test host. scripts/Test-IntegrationTests.ps1 runs
# tests in a container on helpdesk_default, where `sqlserver` is the SQL service
# DNS name. For host-run `dotnet test`, use localhost,1433 instead.
ConnectionStrings__IntegrationTestConnection=Server=sqlserver,1433;Database=HelpDesk_IntegrationTests;User Id=sa;Password=REPLACE_WITH_A_UNIQUE_STRONG_SQL_PASSWORD;TrustServerCertificate=True

# Docker Compose settings.
# Required by the Compose SQL Server and API; use the same local-only password
# in the two connection strings above. Do not reuse a production credential.
MSSQL_SA_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_SQL_PASSWORD

# Required by the Compose API for signing authentication tokens. Generate a
# separate random key of at least 32 bytes; never use the SQL password here.
Jwt__Key=REPLACE_WITH_A_UNIQUE_RANDOM_KEY_AT_LEAST_32_BYTES

# Optional Compose API setting; defaults to redis:6379 on the Compose network.
# A host-launched API instead uses localhost:6379 from Development settings.
ConnectionStrings__Redis=redis:6379

# Optional Compose CORS origin; defaults to http://localhost. Set this to the
# browser origin used to access the local frontend when it differs.
CORS_ORIGIN=http://localhost

# Optional SMTP authentication. The local Compose Mailpit service needs no
# credentials, so leave these blank unless configuring an authenticated relay.
Smtp__Username=
Smtp__Password=

# CI uses the separate GitHub Actions secret SQLSERVER_SA_PASSWORD for its
# temporary SQL Server container. Do not put that CI secret in this file.
