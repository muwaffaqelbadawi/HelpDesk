{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },

  "Kestrel": {
    "Certificates": {
      "Default": {
        "Pem": "../../dev_certificate/cert.pem",
        "Key": "../../dev_certificate/key.pem"
      }
    }
  },

  "ConnectionStrings": {
    "AppDBConnection": ""
  },

  "Jwt": {
    "Issuer": "HelpDesk.API",
    "Audience": "HelpDesk.Client",
    "AccessTokenExpiryMinutes": 10,
    "RefreshTokenExpiryDays": 7
  },

  "UserSession": {
    "DefaultSessionExpiryMinutes": 30,
    "PersistentSessionExpiryDays": 7
  },

  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "UseSsl": false,
    "SenderName": "HelpDesk.HelpDesk",
    "SenderEmail": "noreply@helpdesk_test.local"
  },

  "Cors": {
    "Name": "Frontend",
    "Origins": ["https://localhost:4200"]
  },

  "DataImport": {
    "RelativePath": "src/Infrastructure/Services/DataIngestion/Importing/Importers/Countries/data/countries.json"
  }
}
